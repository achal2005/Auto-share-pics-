# =============================================================================
# AutoSharePics — Environment template
# =============================================================================
# Copy to .env, then run:  node scripts/validate-env.js
# Generate strong secrets with: openssl rand -hex 32  (or 16)
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- General -----------------------------------------------------------------
TIMEZONE=Asia/Kolkata

# --- Application Database (PostgreSQL) ---------------------------------------
APP_DB_USER=autoshare
APP_DB_PASSWORD=                        # openssl rand -hex 32  (>=16 chars)
APP_DB_NAME=autosharepics
# APP_DB_PORT only matters if you uncomment the host port mapping in compose.
APP_DB_PORT=5433

# --- n8n ---------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# N8N_AUTH_USER and N8N_AUTH_PASSWORD are deprecated in n8n 1.x.
# Auth is now handled via the n8n UI owner account setup on first launch.
# N8N_AUTH_USER=admin
# N8N_AUTH_PASSWORD=                      # >=16 chars
# Encryption key for n8n-stored credentials. Losing this bricks all stored
# Google Drive / Postgres / Evolution credentials in n8n. Back it up.
N8N_ENCRYPTION_KEY=                     # openssl rand -hex 32  (must be >=32)

# --- CompreFace --------------------------------------------------------------
CF_DB_USER=compreface
CF_DB_PASSWORD=                         # openssl rand -hex 32  (do NOT reuse APP_DB_PASSWORD)
CF_API_PORT=8000
# Image edge limit. 1024 catches small faces in 5+ person group shots; lower
# values speed up CompreFace but cost recall.
CF_IMG_LIMIT=1024
CF_UWSGI_PROCESSES=2
CF_UWSGI_THREADS=1
# Recognition API key from CompreFace UI. Created AFTER first boot:
#   1. open http://localhost:8000  -> create account
#   2. create application "AutoSharePics"
#   3. add "Recognition" service, copy API key here
CF_RECOGNITION_API_KEY=

# --- Evolution API (WhatsApp) -----------------------------------------------
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=                      # openssl rand -hex 32 (>=32)
EVOLUTION_DB_NAME=evolution_api
EVOLUTION_INSTANCE_NAME=autoshare

# --- Google Drive ------------------------------------------------------------
# OAuth handled inside n8n credentials UI. Set the watched folder ID here:
GDRIVE_FOLDER_ID=

# --- WhatsApp routing --------------------------------------------------------
# Country-code-prefixed digits ONLY, no leading + sign. Example: 919876543210
MY_WHATSAPP_NUMBER=
# Group JID is discovered after pairing. Run:
#   curl -H "apikey: $EVOLUTION_API_KEY" \
#     http://localhost:8080/group/fetchAllGroups/autoshare
# and copy the desired groupJid (ends with @g.us). Empty string is allowed —
# delivery falls back to DM-only when the group JID is missing.
WHATSAPP_GROUP_JID=

# --- Geofence webhook (iOS Shortcut HMAC) -----------------------------------
# 03-deliver verifies HMAC-SHA256(body, GEOFENCE_WEBHOOK_SECRET) against the
# X-Hub-Signature-256 header. Generate: openssl rand -hex 32
GEOFENCE_WEBHOOK_SECRET=

# --- Face recognition tuning -------------------------------------------------
# Below 0.85 the false-positive rate is high when the friend list is small.
FACE_CONFIDENCE_THRESHOLD=0.88
FACE_DETECT_LIMIT=15

# --- WhatsApp ban-prevention throttles --------------------------------------
WA_MIN_DELAY_MS=4000
WA_MAX_DELAY_MS=12000
WA_BATCH_SIZE=8
WA_BATCH_COOLDOWN_MS=180000

# --- Production overlay (only used by docker-compose.prod.yml) --------------
# PUBLIC_DOMAIN=share.example.com
# PUBLIC_EMAIL=ops@example.com
# N8N_PUBLIC_HOST=n8n.share.example.com
# CF_ADMIN_BASICAUTH_HASH=               # caddy hash-password output
